rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function treeDoc(treeId) {
      return get(/databases/$(database)/documents/trees/$(treeId));
    }

    function treeExists(treeId) {
      return exists(/databases/$(database)/documents/trees/$(treeId));
    }

    function isTreeMemberById(treeId) {
      return signedIn()
        && treeExists(treeId)
        && request.auth.uid in treeDoc(treeId).data.memberIds;
    }

    function isTreeEditorById(treeId) {
      return signedIn()
        && treeExists(treeId)
        && request.auth.uid in treeDoc(treeId).data.editorIds;
    }

    function isTreeOwnerById(treeId) {
      return signedIn()
        && treeExists(treeId)
        && treeDoc(treeId).data.ownerId == request.auth.uid;
    }

    function isExistingTreeMember() {
      return signedIn() && request.auth.uid in resource.data.memberIds;
    }

    function isExistingTreeEditor() {
      return signedIn() && request.auth.uid in resource.data.editorIds;
    }

    function isExistingTreeOwner() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function treeMetadataKeys() {
      return [
        'name',
        'kinshipSystem',
        'discoverable',
        'searchKeywords',
        'approvalWindowHours',
        'surnameVariantGroups',
        'updatedAt',
      ];
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /trees/{treeId} {
      allow read: if isExistingTreeMember();
      allow create: if false;
      allow update: if (
          isExistingTreeEditor()
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.memberIds == resource.data.memberIds
          && request.resource.data.editorIds == resource.data.editorIds
          && request.resource.data.collaborators == resource.data.collaborators
          && request.resource.data.membershipHistory == resource.data.membershipHistory
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(treeMetadataKeys())
        );
      allow delete: if false;
    }

    match /personTrash/{personId} {
      allow read: if isTreeMemberById(resource.data.treeId);
      allow create, update, delete: if false;
    }

    match /persons/{personId} {
      allow read: if isTreeMemberById(resource.data.treeId);
      allow create, update, delete: if false;
    }

    match /relationships/{relationshipId} {
      allow read: if isTreeMemberById(resource.data.treeId);
      allow create, update, delete: if false;
    }

    match /mergeRequests/{requestId} {
      allow read: if isTreeMemberById(resource.data.sourceTreeId) || isTreeMemberById(resource.data.targetTreeId);
      allow write: if false;
    }

    match /mergeHistory/{historyId} {
      allow read: if ('sourceTreeId' in resource.data && isTreeMemberById(resource.data.sourceTreeId))
        || ('targetTreeId' in resource.data && isTreeMemberById(resource.data.targetTreeId))
        || (
          resource.data.involvedTreeIds.size() > 0
          && isTreeMemberById(resource.data.involvedTreeIds[0])
        ) || (
          resource.data.involvedTreeIds.size() > 1
          && isTreeMemberById(resource.data.involvedTreeIds[1])
        );
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.userId == request.auth.uid
        || (
          resource.data.type == 'tree-access-request'
          && resource.data.requestedByUserId == request.auth.uid
        )
      );
      allow create: if signedIn()
        && (
          (
            request.resource.data.type == 'merge-invite'
            && request.resource.data.requestedByUserId == request.auth.uid
            && isTreeEditorById(request.resource.data.sourceTreeId)
          ) || (
            request.resource.data.type == 'tree-access-request'
            && request.resource.data.requestedByUserId == request.auth.uid
            && treeExists(request.resource.data.sourceTreeId)
            && treeDoc(request.resource.data.sourceTreeId).data.ownerId == request.resource.data.userId
          ) || (
            request.resource.data.type == 'tree-access-response'
            && request.resource.data.requestedByUserId == request.auth.uid
            && treeExists(request.resource.data.sourceTreeId)
            && treeDoc(request.resource.data.sourceTreeId).data.ownerId == request.auth.uid
          )
        );
    }

    match /notificationActivity/{stateId} {
      allow read, update, delete: if signedIn() && request.auth.uid == resource.data.userId;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /approvalRequests/{requestId} {
      allow read: if isTreeMemberById(resource.data.treeId);
      allow write: if false;
    }

    match /emailDeliveries/{deliveryId} {
      allow read: if false;
      allow write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function treeDoc(treeId) {
      return get(/databases/$(database)/documents/trees/$(treeId));
    }

    function isTreeOwner(treeId) {
      return signedIn() && treeDoc(treeId).data.ownerId == request.auth.uid;
    }

    function isTreeMember(treeId) {
      return signedIn() && request.auth.uid in treeDoc(treeId).data.memberIds;
    }

    function isTreeEditor(treeId) {
      return signedIn() && request.auth.uid in treeDoc(treeId).data.editorIds;
    }

    function isOwnPersonAssignmentUpdate(treeId) {
      return signedIn()
        && isTreeMember(treeId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['personAssignments', 'updatedAt'])
        && request.resource.data.personAssignments is map
        && (
          !(resource.data.personAssignments is map)
          || request.resource.data.personAssignments.diff(resource.data.personAssignments).affectedKeys().hasOnly([request.auth.uid])
        )
        && (
          !(resource.data.personAssignments is map)
          || !(request.auth.uid in resource.data.personAssignments)
          || !(request.auth.uid in request.resource.data.personAssignments)
          || request.resource.data.personAssignments[request.auth.uid] == resource.data.personAssignments[request.auth.uid]
        )
        && (
          !(request.auth.uid in request.resource.data.personAssignments)
          || (
            request.resource.data.personAssignments[request.auth.uid] is string
            && exists(/databases/$(database)/documents/persons/$(request.resource.data.personAssignments[request.auth.uid]))
            && get(/databases/$(database)/documents/persons/$(request.resource.data.personAssignments[request.auth.uid])).data.treeId == treeId
          )
        );
    }

    function isPendingApprovalDecisionUpdate() {
      return resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'decisionMode',
          'decidedAt',
          'decidedByUserId',
          'decidedByLabel',
          'appliedAt',
          'updatedAt'
        ]);
    }

    function isManualApprovalDecision() {
      return isPendingApprovalDecisionUpdate()
        && request.auth.uid in resource.data.eligibleApproverIds
        && request.resource.data.status in ['applied', 'rejected']
        && request.resource.data.decisionMode == 'manual'
        && request.resource.data.decidedAt is string
        && request.resource.data.decidedByUserId == request.auth.uid
        && request.resource.data.decidedByLabel is string
        && request.resource.data.updatedAt is string
        && (
          (request.resource.data.status == 'applied' && request.resource.data.appliedAt is string)
          || (
            request.resource.data.status == 'rejected'
            && (
              !('appliedAt' in request.resource.data)
              || request.resource.data.appliedAt == resource.data.appliedAt
            )
          )
        );
    }

    function isAutoApprovalDecision() {
      return isPendingApprovalDecisionUpdate()
        && resource.data.expiresAtMillis is number
        && request.time.toMillis() >= resource.data.expiresAtMillis
        && request.resource.data.status == 'applied'
        && request.resource.data.decisionMode == 'auto'
        && request.resource.data.decidedAt is string
        && request.resource.data.decidedByUserId == ''
        && request.resource.data.decidedByLabel == 'Automatic approval timer'
        && request.resource.data.appliedAt is string
        && request.resource.data.updatedAt is string;
    }

    function isApprovalRequestBaseCreate() {
      return request.resource.data.treeId is string
        && request.resource.data.entityType in ['person', 'relationship']
        && request.resource.data.operation in [
          'update-person',
          'delete-person',
          'create-relationship',
          'delete-relationship'
        ]
        && request.resource.data.targetId is string
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.requestedByUserId == request.auth.uid
        && request.resource.data.requestedByLabel is string
        && request.resource.data.eligibleApproverIds is list
        && request.resource.data.payload is map
        && request.resource.data.expiresAt is string
        && request.resource.data.expiresAtMillis is number
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
    }

    function isPendingApprovalRequestCreate() {
      return isApprovalRequestBaseCreate()
        && request.resource.data.status == 'pending'
        && request.resource.data.decisionMode == 'manual'
        && !('decidedAt' in request.resource.data)
        && !('decidedByUserId' in request.resource.data)
        && !('decidedByLabel' in request.resource.data)
        && !('appliedAt' in request.resource.data);
    }

    function isImmediateApprovalRequestCreate() {
      return isApprovalRequestBaseCreate()
        && request.resource.data.status == 'applied'
        && request.resource.data.decisionMode == 'immediate'
        && request.resource.data.decidedAt is string
        && request.resource.data.decidedByUserId == request.auth.uid
        && request.resource.data.decidedByLabel is string
        && request.resource.data.appliedAt is string;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner(userId);
    }

    match /trees/{treeId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.auth.uid in request.resource.data.memberIds
        && request.auth.uid in request.resource.data.editorIds
        && request.resource.data.personAssignments is map
        && (!('approvalWindowHours' in request.resource.data) || request.resource.data.approvalWindowHours is number);
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow update: if (
          isTreeOwner(treeId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.name is string
          && request.resource.data.memberIds is list
          && request.resource.data.editorIds is list
          && request.resource.data.collaborators is list
          && (!('approvalWindowHours' in request.resource.data) || request.resource.data.approvalWindowHours is number)
        )
        || isOwnPersonAssignmentUpdate(treeId);
      allow delete: if isTreeOwner(treeId);
    }

    match /approvalRequests/{requestId} {
      allow create: if signedIn()
        && isApprovalRequestBaseCreate()
        && isTreeMember(request.resource.data.treeId)
        && (isPendingApprovalRequestCreate() || isImmediateApprovalRequestCreate());
      allow read: if isTreeMember(resource.data.treeId);
      allow update: if isTreeMember(resource.data.treeId)
        && (isManualApprovalDecision() || isAutoApprovalDecision());
      allow delete: if isTreeOwner(resource.data.treeId);
    }

    match /persons/{personId} {
      allow create: if signedIn()
        && request.resource.data.treeId is string
        && request.resource.data.firstName is string
        && isTreeEditor(request.resource.data.treeId);
      allow read: if isTreeMember(resource.data.treeId);
      allow update: if isTreeEditor(resource.data.treeId)
        && request.resource.data.treeId == resource.data.treeId
        && request.resource.data.firstName is string;
      allow delete: if isTreeEditor(resource.data.treeId);
    }

    match /relationships/{relationshipId} {
      allow create: if signedIn()
        && request.resource.data.treeId is string
        && request.resource.data.fromPersonId is string
        && request.resource.data.toPersonId is string
        && request.resource.data.type in ['parent-child', 'spouse']
        && isTreeEditor(request.resource.data.treeId);
      allow read: if isTreeMember(resource.data.treeId);
      allow delete: if isTreeEditor(resource.data.treeId);
      allow update: if false;
    }
  }
}

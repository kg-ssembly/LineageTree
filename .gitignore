# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
.npm-cache/

# Expo
.expo/
dist/
.test-dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Functions output is normally ignored, while the small set of historically
# tracked entry files and this lifecycle service remain deployable before a
# fresh build has run.
/functions/lib/**
!/functions/lib/functions/
!/functions/lib/functions/src/
!/functions/lib/functions/src/services/
/functions/lib/functions/src/services/**
!/functions/lib/functions/src/services/account-lifecycle-function.js
playwright-report/
test-results/
*-debug.log

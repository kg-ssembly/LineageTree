{
  "name": "Lineage Tree",
  "version": "1.0.17",
  "main": "index.ts",
  "engines": {
    "node": ">=20 <24"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:core && npm run test:auth",
    "test:auth": "node --test tests/account-linking-store.test.cjs",
    "test:core": "tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "test:relationships": "tsc -p tsconfig.test.json && node --test .test-dist/tests/relationship-engine.test.js",
    "migrate:profile-components": "node scripts/migrate-profile-component-duplicates.mjs",
    "verify:release": "npm run typecheck && npm run lint && npm test && npm run test:functions && npm run test:integration && npm run test:e2e && npm run export:web",
    "build:functions": "npx tsc -p functions/tsconfig.json",
    "export:web": "expo export --platform web",
    "deploy:web": "expo export --platform web && node -e \"require('fs').cpSync('web-public','dist',{recursive:true,force:true})\" && npx firebase-tools deploy --only hosting",
    "deploy:functions": "npm run build:functions && npx firebase-tools deploy --only functions",
    "deploy:indexes": "npx firebase-tools deploy --only firestore:indexes",
    "deploy:firebase": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "prebuild:android": "node scripts/prepare-android-release.mjs",
    "build:android": "eas build --platform android --profile production",
    "build:preview": "eas build --platform android --profile preview",
    "update:preview": "eas update --channel preview --message \"Preview update\"",
    "update:production": "eas update --channel production --message \"Production update\"",
    "submit:android": "eas submit --platform android",
    "test:integration": "npm run build:functions && firebase emulators:exec --project demo-lineagetree --config firebase.test.json --only firestore,auth,storage \"node --test tests/integration/*.test.cjs\"",
    "test:e2e": "npm run build:functions && firebase emulators:exec --project demo-lineagetree --config firebase.test.json --only firestore,auth,functions \"playwright test\"",
    "test:functions": "npm --prefix functions test",
    "migrate:family-data": "node scripts/migrate-family-data.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@firebase/auth": "^1.13.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/material-top-tabs": "^7.4.24",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.11",
    "expo": "~54.0.37",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.11",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "firebase": "^12.12.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-pager-view": "6.9.1",
    "react-native-paper": "^5.15.1",
    "react-native-paper-dates": "^0.23.6",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-tab-view": "^4.3.0",
    "react-native-web": "^0.21.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.30.0",
    "globals": "^17.7.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
